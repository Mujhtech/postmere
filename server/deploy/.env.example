# Run Docker Compose from this directory. Copy to .env and chmod 600 .env.
POSTMERE_HOST=mail.example.com
POSTMERE_ACME_EMAIL=owner@example.com
POSTMERE_IMAGE_TAG=local
CADDY_IMAGE=caddy:2-alpine

# Three independent passwords, each 64 hexadecimal characters. The included
# generator creates these without exposing secrets in terminal output.
POSTMERE_ADMIN_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
POSTMERE_OWNER_DB_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
POSTMERE_RUNTIME_DB_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
POSTMERE_CREDENTIAL_KEYS='{"1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}'
POSTMERE_ACTIVE_CREDENTIAL_KEY=1
POSTMERE_RATE_LIMIT_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY

# Postmere advertises RFC 9207 issuer identification. Use this stable callback
# when ChatGPT shows it, or replace with the exact callback in its setup page.
POSTMERE_MCP_REDIRECT_URIS='["https://chatgpt.com/connector_platform_oauth_redirect"]'

# Mail provider OAuth web applications. Configure callbacks documented below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Optional APNs. Put the private key in ./secrets/apns.p8 on the server only.
# The container runs as UID 65532: grant that UID read access to the key.
# POSTMERE_APNS_KEY_FILE=/run/secrets/apns.p8
# POSTMERE_APNS_KEY_ID=
# POSTMERE_APNS_TEAM_ID=6JR3ZGLPD6
# POSTMERE_APNS_TOPIC=mujhtech.postmere
# POSTMERE_APNS_ENVIRONMENT=production

# Optional AI. Users must also opt in from the app.
# By default AI uses OpenAI with OPENAI_API_KEY. To keep mail on infrastructure
# you control, point POSTMERE_AI_BASE_URL at any OpenAI Responses-compatible
# server instead (plain http is allowed only on private networks):
#   Self-hosted:  POSTMERE_AI_BASE_URL=http://ollama:11434/v1   (no key needed)
#   Azure OpenAI: POSTMERE_AI_BASE_URL=https://NAME.openai.azure.com/openai/v1
#                 POSTMERE_AI_AUTH=api-key
# Set POSTMERE_AI_ZERO_RETENTION=true only when the provider keeps no request
# data (an approved OpenAI zero data retention agreement, or a self-hosted
# model); users see this in the AI data notice. Sender research needs hosted
# web search and is off by default for providers other than OpenAI.
# OPENAI_API_KEY=
# POSTMERE_AI_BASE_URL=
# POSTMERE_AI_API_KEY=
# POSTMERE_AI_AUTH=bearer
# POSTMERE_AI_PROVIDER_NAME=
# POSTMERE_AI_ZERO_RETENTION=false
# POSTMERE_AI_WEB_SEARCH=
# POSTMERE_AI_MODEL=your-supported-model-id
# POSTMERE_DECISION_URL=https://analyzer.example.com/check
# POSTMERE_DECISION_TOKEN=

# Optional provider notifications. Polling continues if these are not configured.
# Google: configure all four values and an authenticated Pub/Sub push subscription.
# POSTMERE_GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/postmere-mail
# POSTMERE_GMAIL_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/postmere-mail
# POSTMERE_GMAIL_PUSH_AUDIENCE=https://mail.example.com/v1/webhooks/gmail
# POSTMERE_GMAIL_PUSH_SERVICE_ACCOUNT=postmere-push@YOUR_PROJECT.iam.gserviceaccount.com
# Microsoft: requires the public HTTPS origin and delegated mail credentials.
# POSTMERE_MICROSOFT_WEBHOOKS=true
